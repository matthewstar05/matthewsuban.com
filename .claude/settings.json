{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx playwright test:*)",
      "Bash(SHOTS_PATH=* npm run shots)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next typegen:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(./node_modules/next/dist/docs/**)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(git push:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
